# Copy to .env and fill in. Get a key at https://dashboard.sarvam.ai (₹1,000 free credits).
SARVAM_API_KEY=your-key-here

# Optional — private visitor dashboard at /stats.html (token sent as a header)
STATS_TOKEN=pick-any-long-random-string

# Optional — turns per IP per hour on the public demo (default 40)
RATE_LIMIT_PER_HOUR=40

# Optional persistence for stats + shared rate-limit counters.
# Without either, tracking still works (structured logs) and limits are per-instance.
#
# (a) Upstash via the Vercel Marketplace — REST, no open ports:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# (b) Your own Redis — must be reachable from wherever the code RUNS.
#     127.0.0.1 only works when the app runs on that same machine; from a
#     serverless function it points at the function's own container. Use the
#     host's public endpoint, and rediss:// for TLS.
# REDIS_URL=rediss://:password@redis.example.com:6379/0
