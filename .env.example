# Copy to .env and fill in. Get a key at https://dashboard.sarvam.ai (₹1,000 free credits).
SARVAM_API_KEY=your-key-here

# Optional — private visitor dashboard at /api/stats?token=...
STATS_TOKEN=pick-any-long-random-string

# Optional — turns per IP per hour on the public demo (default 40)
RATE_LIMIT_PER_HOUR=40

# Optional — only if you provision Upstash Redis via the Vercel Marketplace.
# Without these, tracking still works (structured logs) and rate limiting is per-instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
